#!/bin/bash -l
#SBATCH --chdir /scratch/saporito/Frag3D/vel-sweep-10000
#SBATCH --job-name Frag3D_stress
#SBATCH -o out_Frag3D.%j
#SBATCH -e err_Frag3D.%j
#SBATCH --account lsms
#SBATCH --nodes 1
#SBATCH --ntasks-per-node 72
#SBATCH --time 24:00:00

module purge
module restore akantu_env

echo STARTING AT $(date)

#TEST

srun /home/saporito/Frag3D/cpp/build/cpp/cohesive_sim -v 10000 -t 0.4 -T 0.00004 -msh "/home/saporito/Frag3D/input/mesh/plate_5.00e-02x5.00e-02x1.00e-03_P2.msh" -mat "/home/saporito/Frag3D/input/material/material_linear_nsn.dat" \
    --kappa 0.2 --center_x 0.0 --center_y 0.0 --z_sign 1.0 --shape "gaussian" --angle_xz 0.0 --angle_yz 0.0


echo FINISHED AT $(date)
